#!/usr/bin/env python3
"""Claude protocol binding for shared bounded Musubi SessionStart continuity.

The bounded, fail-open, owned-scope chronology renderer lives in
``musubi_harness.plugin_continuity.PluginContinuity``. Claude Code injects this
hook's stdout as session context; this binding only prints that shared block.
"""

from __future__ import annotations

import base64
import json
import os
import re
import subprocess  # re-exported for adapter tests and fault injection
from typing import Any

from musubi_claude_runtime import runtime
from musubi_harness.plugin_continuity import MAX_CONTENT, MAX_ROWS, PluginContinuity


_continuity = PluginContinuity(runtime)
continuity_block = _continuity.continuity_block
_rows = _continuity._rows
_compact = _continuity._compact


def _claims(token: str) -> dict[str, Any] | None:
    """The token's JWT claims, decoded locally and unverified. Never the token itself."""
    parts = token.split(".")
    if len(parts) != 3:
        return None
    try:
        claims = json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))
    except (ValueError, UnicodeDecodeError):
        return None
    return claims if isinstance(claims, dict) else None


def _grants_write(scope: Any, namespace: str) -> bool:
    """True when a scope entry grants write on ``namespace``, exactly as Musubi decides.

    Mirrors musubi/auth/scopes.py (_parse_namespace_scope, _namespace_matches,
    _namespace_scope_allows): "pattern:access" split on the last colon, access
    r, w or rw; a bare ``**`` matches everything but never grants write; any
    other pattern needs the same number of segments, each ``*`` or literal.
    A looser matcher would call a ``**:rw`` token fine and then 403 (Aoi's review).
    """
    entries = scope.split() if isinstance(scope, str) else scope if isinstance(scope, list) else []
    wanted = namespace.split("/")
    for entry in entries:
        if not isinstance(entry, str) or ":" not in entry:
            continue
        pattern, access = entry.rsplit(":", 1)
        if access not in ("w", "rw") or pattern == "**":
            continue
        parts = pattern.split("/")
        if len(parts) == len(wanted) and all(p == "*" or p == n for p, n in zip(parts, wanted, strict=True)):
            return True
    return False


_PRESENCE = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}")


def _shown(value: Any) -> str:
    """An unverified claim as it may appear in a message: presence-shaped, or a label.

    A token's sub is untrusted input; a newline or control characters in it must
    not forge a second line in the systemMessage (Yua's review of harness #12).
    """
    return value if isinstance(value, str) and _PRESENCE.fullmatch(value) else "an unrecognised subject"


def token_warning() -> str | None:
    """Say so when the Musubi token belongs to another presence or cannot write this one.

    Aoi's 0.5.0 canary: the plugin token was another seat's (sub aoi/voice, read-only
    on aoi/command-chair). Reads worked; every delivery 403'd at the drain, silently.
    The claims decode locally, so the mismatch can be named on the first turn.
    """
    token = os.environ.get("MUSUBI_TOKEN", "").strip()
    if not token:
        return None
    try:
        presence = runtime.runtime_config().presence
    except Exception:  # noqa: BLE001 - identity problems are reported elsewhere
        return None
    claims = _claims(token)
    if claims is None:
        return None
    sub = claims.get("sub")
    problems = []
    if isinstance(sub, str) and sub != presence:
        problems.append(f"the Musubi token is for {_shown(sub)}, but this seat is {_shown(presence)}")
    if not _grants_write(claims.get("scope"), f"{presence}/episodic"):
        problems.append(f"the token cannot write {_shown(presence)}/episodic, so nothing will be delivered")
    if not problems:
        return None
    return "Musubi memory: " + "; ".join(problems) + ". Enter the right token for this seat in the plugin settings."


def main() -> int:
    warning = token_warning()
    block = continuity_block()
    if warning is None:
        print(block)  # unchanged output when the token fits this seat
        return 0
    print(json.dumps({"systemMessage": warning, "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": block}}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
