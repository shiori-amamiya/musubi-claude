#!/bin/sh
# Launch a musubi-claude hook or the MCP server with a Python that can import
# musubi-harness. Never installs anything and never touches the network: the
# explicit setup step (scripts/musubi-claude-setup, or /musubi-claude:setup)
# builds the environment ahead of time.
#
# Python, in order:
#   1. the plugin's own environment: $CLAUDE_PLUGIN_DATA/venv/bin/python
#   2. a python3 on PATH that already imports musubi_harness (e.g. a user who
#      ran `pip install musubi-harness` themselves)
# The harness must be at least the version in scripts/harness-requirement; an
# older one (left by a previous setup) is refused as harness_outdated.
# Otherwise the hook refuses to run, records why, and exits 0 so the Claude
# Code session continues. The MCP server exits non-zero so /mcp shows it failed.
set -u
component="${1:-}"
case "$component" in
  stop|session-start|mcp|health|prompt|thoughts|compact) ;;
  *) echo "musubi-claude-run: unknown component '$component'" >&2; exit 2 ;;
esac
root="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
data="${CLAUDE_PLUGIN_DATA:-$HOME/.local/state/musubi-claude}"
script="$root/scripts/musubi-claude-$component"
shift

required="$(sed -n 's/^musubi-harness==//p' "$root/scripts/harness-requirement" 2>/dev/null)"

# version_lt A B: true when dotted version A is older than B. Each part is
# compared by its leading digits; a part with a suffix (1.1.0rc1, 1.1.0.dev2)
# sorts below the same number without one, so a pre-release never passes for
# the release it precedes.
version_lt() {
  a="$1" b="$2"
  while [ -n "$a$b" ]; do
    pa="${a%%.*}"; pb="${b%%.*}"
    case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
    x="${pa%%[!0-9]*}"; y="${pb%%[!0-9]*}"
    [ "${x:-0}" -lt "${y:-0}" ] && return 0
    [ "${x:-0}" -gt "${y:-0}" ] && return 1
    [ "$pa" != "$x" ] && [ "$pb" = "$y" ] && return 0
    [ "$pa" = "$x" ] && [ "$pb" != "$y" ] && return 1
  done
  return 1
}

# Python and the harness version it carries, in order:
python="" installed=""
if [ -x "$data/venv/bin/python" ]; then
  # Read the version from the installed metadata directory: no Python start-up
  # on a path that runs for every prompt. Look only in the site-packages of the
  # interpreter the venv runs (pyvenv.cfg: uv writes version_info, venv writes
  # version). Re-running setup can move a venv to a newer Python in place and
  # leave the old lib/pythonX.Y behind with a stale harness in it.
  pyver="$(sed -n -e 's/^version_info *= *\([0-9]*\.[0-9]*\).*/\1/p' -e 's/^version *= *\([0-9]*\.[0-9]*\).*/\1/p' \
    "$data/venv/pyvenv.cfg" 2>/dev/null | head -n 1)"
  # scan DIR: the highest harness version in one site-packages directory. The
  # caller quotes DIR, so a data path with spaces stays one word (Aoi's review).
  scan() {
    for info in "$1"/musubi_harness-*.dist-info; do
      [ -d "$info" ] || continue
      found="${info##*/musubi_harness-}"; found="${found%.dist-info}"
      # The highest version wins, never the lexically last directory.
      if [ -z "$installed" ] || version_lt "$installed" "$found"; then installed="$found"; fi
      python="$data/venv/bin/python"
    done
  }
  if [ -n "$pyver" ] && [ -d "$data/venv/lib/python$pyver/site-packages" ]; then
    scan "$data/venv/lib/python$pyver/site-packages"
  else
    for s in "$data"/venv/lib/python*/site-packages; do scan "$s"; done
  fi
elif command -v python3 >/dev/null 2>&1; then
  installed="$(python3 -c 'import importlib.metadata as m, musubi_harness; print(m.version("musubi-harness"))' 2>/dev/null)"
  [ -n "$installed" ] && python="$(command -v python3)"
fi

reason="harness_unavailable"
if [ -n "$python" ] && [ -n "$required" ] && version_lt "$installed" "$required"; then
  # A plugin update raised the pin but the environment still has the old
  # harness. Running it would fail on import (AttributeError) with a traceback
  # and no hint; refuse visibly instead.
  reason="harness_outdated"
  python=""
fi

if [ -n "$python" ]; then
  exec "$python" "$script" "$@"
fi

if [ "$reason" = harness_outdated ]; then
  problem="musubi-harness $installed is older than the required $required"
else
  problem="musubi-harness is not installed"
fi

# Not set up (or out of date). Prompt recall and compaction stay silent and
# record nothing: without the harness there were no Musubi tool results to
# checkpoint, and session-start already tells the user once.
if [ "$component" = prompt ] || [ "$component" = compact ]; then
  exit 0
fi

# Not set up (or out of date). The health report says so as data and records
# nothing (it is a read-only question, not a failed capture).
if [ "$component" = health ]; then
  printf '{"setup": false, "error": "%s", "installed": "%s", "required": "%s", "fix": "run /musubi-claude:setup"}\n' \
    "$reason" "$installed" "$required"
  exit 0
fi

# Record it the same way other degradations are recorded, without reading or
# storing any conversation content.
mkdir -p "$data" 2>/dev/null
printf '{"at": "%s", "reason": "%s:%s"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" "$component" >> "$data/degraded.jsonl" 2>/dev/null
case "$component" in
  mcp)
    echo "musubi-claude: $problem. Run /musubi-claude:setup, then restart." >&2
    exit 1 ;;
  session-start)
    if [ "$reason" = harness_outdated ]; then
      printf '{"systemMessage": "Musubi memory needs a one-time update (%s), so nothing is captured or recalled until then. Run /musubi-claude:setup."}\n' "$problem"
    else
      printf '%s\n' '{"systemMessage": "Musubi memory is not set up yet, so nothing is captured or recalled. Run /musubi-claude:setup once."}'
    fi
    exit 0 ;;
  *)
    exit 0 ;;
esac
