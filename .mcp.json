{
  "mcpServers": {
    "musubi-claude": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/musubi-claude-run",
      "env": {
        "CLAUDE_PLUGIN_OPTION_ACTOR": "${user_config.actor}",
        "CLAUDE_PLUGIN_OPTION_SEAT": "${user_config.seat}",
        "CLAUDE_PLUGIN_OPTION_ZONE": "${user_config.zone}",
        "CLAUDE_PLUGIN_OPTION_DELIVERY_MODE": "${user_config.delivery_mode}",
        "CLAUDE_PLUGIN_OPTION_MUSUBI_URL": "${user_config.musubi_url}",
        "CLAUDE_PLUGIN_OPTION_MUSUBI_TOKEN": "${user_config.musubi_token}",
        "CLAUDE_PLUGIN_OPTION_PROMPT_RECALL": "${user_config.prompt_recall}"
      },
      "args": [
        "mcp"
      ]
    }
  }
}
